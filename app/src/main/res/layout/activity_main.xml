<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📱 滑动模拟器"
            android:textColor="@color/text1"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="16dp"/>

        <!-- 运行状态 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="14dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="运行状态"
                android:textColor="@color/text2"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:id="@+id/tv_run_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="状态：空闲 ｜ 已滑动：0 次"
                android:textColor="@color/primary"
                android:textSize="14sp"
                android:layout_marginBottom="12dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_show_floating"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="显示悬浮窗"
                    android:background="@drawable/bg_btn_primary"
                    android:textColor="@color/bg"
                    android:textStyle="bold"
                    android:layout_marginEnd="8dp"/>

                <Button
                    android:id="@+id/btn_hide_floating"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="隐藏悬浮窗"
                    android:background="@drawable/bg_dir_normal"
                    android:textColor="@color/text1"
                    android:layout_marginEnd="8dp"/>

                <Button
                    android:id="@+id/btn_quick_start"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="开始"
                    android:background="@drawable/bg_dir_selected"
                    android:textColor="@color/primary"
                    android:layout_marginEnd="8dp"/>

                <Button
                    android:id="@+id/btn_stop"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="停止"
                    android:background="@drawable/bg_btn_stop"
                    android:textColor="@android:color/white"/>
            </LinearLayout>
        </LinearLayout>

        <!-- 权限 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="14dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="必需权限"
                android:textColor="@color/text2"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginBottom="10dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="无障碍服务"
                    android:textColor="@color/text1"
                    android:textSize="14sp"/>
                <TextView
                    android:id="@+id/tv_acc_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="悬浮窗权限"
                    android:textColor="@color/text1"
                    android:textSize="14sp"/>
                <TextView
                    android:id="@+id/tv_overlay_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"/>
            </LinearLayout>
        </LinearLayout>

        <!-- 方向 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="14dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="滑动方向"
                android:textColor="@color/text2"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginBottom="10dp"/>

            <LinearLayout
                android:id="@+id/dir_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/dir_up"
                    style="@style/DirBtn"
                    android:layout_marginEnd="8dp"
                    android:text="↑ 向上"/>

                <TextView
                    android:id="@+id/dir_down"
                    style="@style/DirBtn"
                    android:layout_marginEnd="8dp"
                    android:text="↓ 向下"/>

                <TextView
                    android:id="@+id/dir_left"
                    style="@style/DirBtn"
                    android:layout_marginEnd="8dp"
                    android:text="← 向左"/>

                <TextView
                    android:id="@+id/dir_right"
                    style="@style/DirBtn"
                    android:text="→ 向右"/>
            </LinearLayout>
        </LinearLayout>

        <!-- 参数 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="14dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="滑动参数"
                android:textColor="@color/text2"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginBottom="14dp"/>

            <LinearLayout
                style="@style/ParamRow">
                <TextView style="@style/ParamLabel" android:text="滑动距离"/>
                <TextView android:id="@+id/tv_dist" style="@style/ParamVal" android:text="60%"/>
            </LinearLayout>
            <SeekBar
                android:id="@+id/sb_dist"
                style="@style/ParamSeek"
                android:max="90"
                android:progress="60"/>

            <LinearLayout
                style="@style/ParamRow">
                <TextView style="@style/ParamLabel" android:text="单次滑动时长"/>
                <TextView android:id="@+id/tv_dur" style="@style/ParamVal" android:text="500ms"/>
            </LinearLayout>
            <SeekBar
                android:id="@+id/sb_dur"
                style="@style/ParamSeek"
                android:max="2000"
                android:progress="500"/>

            <LinearLayout
                style="@style/ParamRow">
                <TextView style="@style/ParamLabel" android:text="滑动中途停顿"/>
                <TextView android:id="@+id/tv_mid_pause" style="@style/ParamVal" android:text="0ms"/>
            </LinearLayout>
            <SeekBar
                android:id="@+id/sb_mid_pause"
                style="@style/ParamSeek"
                android:max="5000"
                android:progress="0"/>

            <LinearLayout
                style="@style/ParamRow">
                <TextView style="@style/ParamLabel" android:text="停顿位置"/>
                <TextView android:id="@+id/tv_mid_pos" style="@style/ParamVal" android:text="50%"/>
            </LinearLayout>
            <SeekBar
                android:id="@+id/sb_mid_pos"
                style="@style/ParamSeek"
                android:max="90"
                android:progress="50"/>

            <LinearLayout
                style="@style/ParamRow">
                <TextView style="@style/ParamLabel" android:text="起点偏移"/>
                <TextView android:id="@+id/tv_offset" style="@style/ParamVal" android:text="50%"/>
            </LinearLayout>
            <SeekBar
                android:id="@+id/sb_offset"
                style="@style/ParamSeek"
                android:max="90"
                android:progress="50"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/divider"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="12dp"/>

            <LinearLayout
                style="@style/ParamRow">
                <TextView style="@style/ParamLabel" android:text="滑动间隔（等待）"/>
                <TextView android:id="@+id/tv_interval" style="@style/ParamVal" android:text="30s"/>
            </LinearLayout>
            <SeekBar
                android:id="@+id/sb_interval"
                style="@style/ParamSeek"
                android:max="600"
                android:progress="30"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="💡 流程：滑动 → 等待配置秒数 → 再滑动… 循环直到停止"
                android:textColor="@color/text3"
                android:textSize="12sp"
                android:layout_marginTop="8dp"/>
        </LinearLayout>

        <!-- 说明 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="使用说明"
                android:textColor="@color/text2"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp"/>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="1. 开启无障碍服务 + 悬浮窗权限\n2. 配置方向、距离、间隔秒数（默认30秒）\n3. 点「显示悬浮窗」，自动退到桌面，打开视频APP\n4. 拖动悬浮球移动位置，点击展开/收起面板\n5. 点「▶ 开始滑动」开始循环；点「■ 停止」随时结束"
                android:textColor="@color/text2"
                android:textSize="12sp"
                android:lineSpacingExtra="4dp"/>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
