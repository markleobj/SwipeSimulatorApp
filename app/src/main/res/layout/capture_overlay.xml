<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#66000000">

    <!-- 顶部信息栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:orientation="vertical"
        android:background="#99000000"
        android:padding="12dp">

        <TextView
            android:id="@+id/tv_capture_info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"/>
    </LinearLayout>

    <!-- 十字准星（可拖） -->
    <FrameLayout
        android:id="@+id/cross"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_gravity="top|start"
        android:layout_marginLeft="0dp"
        android:layout_marginTop="0dp">

        <!-- 外圈 -->
        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_cross_outer"/>

        <!-- 竖线 -->
        <View
            android:layout_width="2dp"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:background="#F43F5E"/>

        <!-- 横线 -->
        <View
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:layout_gravity="center"
            android:background="#F43F5E"/>

        <!-- 中心小圆 -->
        <View
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_cross_dot"/>
    </FrameLayout>

    <!-- 底部按钮栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="horizontal"
        android:background="#99000000"
        android:padding="10dp">

        <Button
            android:id="@+id/btn_cancel_point"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginEnd="10dp"
            android:background="@drawable/bg_dir_normal"
            android:text="取消"
            android:textColor="#E2E8F0"
            android:textStyle="bold"/>

        <Button
            android:id="@+id/btn_save_point"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@drawable/bg_btn_primary"
            android:text="保存当前位置"
            android:textColor="#0F172A"
            android:textStyle="bold"/>
    </LinearLayout>
</FrameLayout>
